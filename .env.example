# ReBloom environment variables. Copy to apps/mobile/.env (client) and set server
# secrets via `supabase secrets set` (NEVER commit real values). See PLAN.md.

# ---- Client (apps/mobile/.env) — EXPO_PUBLIC_* are bundled into the app; NEVER put secrets here ----
EXPO_PUBLIC_SUPABASE_URL=            # Supabase project URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=       # Supabase anon key (safe for client; RLS enforces access)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=      # RevenueCat public SDK key (iOS)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=  # RevenueCat public SDK key (Android)

# ---- Server secrets (Supabase Edge Function secrets — `supabase secrets set`, NOT in the app) ----
PERFECTCORP_API_KEY=                 # YouCam API key — server-only. Get at https://yce.perfectcorp.com/ai-api
PERFECTCORP_API_BASE=https://yce-api-01.makeupar.com   # YouCam REST base URL (verified 2026-08-12)

# ---- Optional (added at Deploy, M10) ----
SENTRY_DSN=                          # error monitoring
